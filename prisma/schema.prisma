generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String?
  passwordHash    String? // Null if using OAuth only later
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  // Advanced Security Features
  mfaEnabled    Boolean @default(false)
  mfaSecret     String?
  screenLockPin String? // Hashed PIN for inactivity screen lock

  // Communication Preferences & Identifiers
  telegramChatId  String? @unique
  whatsappConsent Boolean @default(false)
  phone           String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  roles                 UserRole[]
  sessions              Session[]
  auditLogs             AuditLog[]
  telegramLinkingTokens TelegramLinkingToken[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  deviceInfo String?
  ipAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String // e.g., email address
  token      String   @unique
  type       String // e.g., "EMAIL_VERIFICATION", "PASSWORD_RESET", "OTP"
  expiresAt  DateTime

  createdAt DateTime @default(now())

  @@index([identifier, type])
}

// -----------------------------------------------------------------------------
// ROLE BASED ACCESS CONTROL (RBAC)
// -----------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "ADMIN", "USER"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  action      String // e.g., "users.read", "users.create"
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([action])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// -----------------------------------------------------------------------------
// AUDIT LOGGING
// -----------------------------------------------------------------------------

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String // e.g., "LOGIN_SUCCESS", "PASSWORD_CHANGED"
  resource  String? // The entity this action affected
  metadata  Json? // Extra contextual data
  ipAddress String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// BACKGROUND JOBS & QUEUES
// -----------------------------------------------------------------------------

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
  DEAD_LETTER
}

enum JobPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  BULK
}

model Job {
  id       String      @id @default(uuid())
  type     String // e.g., "send-email", "send-sms", "cleanup"
  queue    String      @default("default") // e.g., "email-critical", "sms-default"
  priority JobPriority @default(NORMAL)
  status   JobStatus   @default(PENDING)
  payload  Json // The job arguments

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  // Timing
  availableAt DateTime  @default(now()) // For scheduled jobs or retries
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  // Concurrency & Leasing
  lockedAt DateTime?
  lockedBy String? // Worker ID

  lastError      String? @db.Text
  idempotencyKey String? @unique // Prevent duplicate jobs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queue, status, availableAt, priority])
  @@index([status, lockedAt]) // For finding stuck/crashed jobs
}

// -----------------------------------------------------------------------------
// COMMUNICATION & OBSERVABILITY
// -----------------------------------------------------------------------------

enum CommunicationChannel {
  EMAIL
  SMS
  IN_APP
  TELEGRAM
  WHATSAPP
}

model CommunicationLog {
  id        String               @id @default(uuid())
  jobId     String? // Link back to the job if applicable
  channel   CommunicationChannel
  recipient String // e.g., "j***@example.com" (Masked)
  template  String? // e.g., "auth.login_otp"
  provider  String // e.g., "smtp-primary", "pandora"
  status    String // "SENT", "FAILED", "DELIVERED"

  providerMessageId String? // ID returned by the provider
  errorReason       String? @db.Text
  correlationId     String? // To track related system events

  createdAt DateTime @default(now())

  @@index([channel, status])
  @@index([createdAt])
}

model ProviderHealth {
  id                     String    @id @default(uuid())
  providerName           String    @unique
  status                 String    @default("CLOSED") // CLOSED, OPEN, HALF_OPEN
  consecutiveFailures    Int       @default(0)
  lastSuccessfulDelivery DateTime?
  cooldownUntil          DateTime?

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// OTP & TELEGRAM LINKING
// -----------------------------------------------------------------------------

model OtpRecord {
  id          String               @id @default(uuid())
  userId      String?
  identifier  String // email or phone
  codeHash    String
  channel     CommunicationChannel
  purpose     String // e.g., 'LOGIN', 'PASSWORD_RESET'
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(5)
  expiresAt   DateTime
  invalidated Boolean              @default(false)

  createdAt DateTime @default(now())

  @@index([identifier, purpose, invalidated])
}

model TelegramLinkingToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}
