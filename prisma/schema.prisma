generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String?
  passwordHash    String? // Null if using OAuth only later
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  // Advanced Security Features
  mfaEnabled    Boolean @default(false)
  mfaSecret     String?
  screenLockPin String? // Hashed PIN for inactivity screen lock

  // Communication Preferences & Identifiers
  telegramChatId  String? @unique
  whatsappConsent Boolean @default(false)
  phone           String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  roles                   UserRole[]
  sessions                Session[]
  devices                 UserDevice[]
  authenticators          Authenticator[]
  auditLogs               AuditLog[]
  telegramLinkingTokens   TelegramLinkingToken[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  client            Client?
  agent             Agent?
  contacts          Contact[]
  contactGroups     ContactGroup[]
  contactSegments   ContactSegment[]
  contactTags       ContactTag[]
  contactImports    ContactImport[]
  senderIds         SenderId[]
  smsTemplates      SmsTemplate[]
  campaigns         Campaign[]
  messages          Message[]
  wallets           Wallet?
  transactions      Transaction[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  supportTickets    SupportTicket[]
  scheduledMessages ScheduledMessage[]
  smsDrafts         SmsDraft[]
  customVariables   CustomVariable[]

  gateways Gateway[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  token            String    @unique
  expiresAt        DateTime
  lastActivityAt   DateTime  @default(now())
  idleExpiresAt    DateTime?
  rememberMe       Boolean   @default(false)
  revokedAt        DateTime?
  revocationReason String?
  mfaVerified      Boolean   @default(false)

  deviceInfo String?
  ipAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}

model UserDevice {
  id          String    @id @default(uuid())
  userId      String
  deviceHash  String    @unique // SHA-256 digest of the 32-byte secure random hex device token
  deviceName  String? // Parsed friendly device/browser name
  deviceInfo  String? // Raw user-agent string
  ipAddress   String? // Last seen IP address
  lastLoginAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceHash])
  @@index([userId, revokedAt])
}

model Authenticator {
  id                   String  @id @default(uuid())
  credentialID         Bytes   @unique
  credentialPublicKey  Bytes
  counter              BigInt  @default(0)
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String // e.g., email address
  token      String   @unique
  type       String // e.g., "EMAIL_VERIFICATION", "PASSWORD_RESET", "OTP"
  expiresAt  DateTime

  createdAt DateTime @default(now())

  @@index([identifier, type])
}

// -----------------------------------------------------------------------------
// ROLE BASED ACCESS CONTROL (RBAC)
// -----------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "ADMIN", "USER"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  action      String // e.g., "users.read", "users.create"
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([action])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// -----------------------------------------------------------------------------
// AUDIT LOGGING
// -----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @map("event_id")
  schemaVersion String   @default("1.0") @map("schema_version")
  timestamp     DateTime @map("timestamp")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  eventName     String   @map("event_name")
  category      String   @map("category")
  severity      String   @map("severity")
  outcome       String   @map("outcome") // SUCCESS, FAILURE, DENIED

  // Actor info
  actorType String  @map("actor_type")
  actorId   String? @map("actor_id")
  actorRole String? @map("actor_role")
  tenantId  String? @map("tenant_id")

  // Resource info
  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id")

  // Action info
  action String? @map("action") // CREATE, READ, UPDATE, DELETE

  // Trace / Request Context
  requestId     String? @map("request_id") @db.VarChar(255)
  traceId       String? @map("trace_id") @db.VarChar(255)
  interactionId String? @map("interaction_id") @db.VarChar(255)
  jobId         String? @map("job_id") @db.VarChar(255)
  transactionId String? @map("transaction_id") @db.VarChar(255)

  sourceIp   String? @map("source_ip") @db.VarChar(45)
  userAgent  String? @map("user_agent") @db.Text
  route      String? @map("route")
  httpMethod String? @map("http_method") @db.VarChar(10)
  httpStatus Int?    @map("http_status")

  // Outcome & Changes
  reasonCode      String? @map("reason_code")
  changedFields   Json?   @map("changed_fields") // String array usually
  previousVersion Json?   @map("previous_version")
  newVersion      Json?   @map("new_version")

  // System context
  service      String  @default("range-bulk-sms") @map("service")
  environment  String  @default("production") @map("environment")
  deploymentId String? @map("deployment_id")
  durationMs   Int?    @map("duration_ms")
  description  String? @map("description") @db.Text

  // Tamper resistance
  previousHash String? @map("previous_hash") // hash of the previous log
  hash         String? @map("hash") // hash of this log

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([eventName])
  @@index([recordedAt])
  @@index([requestId])
  @@index([resourceType, resourceId])
  @@index([category, outcome])
  @@index([jobId])
  @@index([tenantId, recordedAt])
  @@index([action, recordedAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// BACKGROUND JOBS & QUEUES
// -----------------------------------------------------------------------------

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
  DEAD_LETTER
}

enum JobPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  BULK
}

model Job {
  id       String      @id @default(uuid())
  type     String // e.g., "send-email", "send-sms", "cleanup"
  queue    String      @default("default") // e.g., "email-critical", "sms-default"
  priority JobPriority @default(NORMAL)
  status   JobStatus   @default(PENDING)
  payload  Json // The job arguments

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  // Timing
  availableAt DateTime  @default(now()) // For scheduled jobs or retries
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  // Concurrency & Leasing
  lockedAt DateTime?
  lockedBy String? // Worker ID

  lastError      String? @db.Text
  idempotencyKey String? @unique // Prevent duplicate jobs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queue, status, availableAt, priority])
  @@index([status, lockedAt]) // For finding stuck/crashed jobs
  @@index([type, status])
  @@index([status, availableAt])
}

// -----------------------------------------------------------------------------
// COMMUNICATION & OBSERVABILITY
// -----------------------------------------------------------------------------

enum CommunicationChannel {
  EMAIL
  SMS
  IN_APP
  TELEGRAM
  WHATSAPP
}

model CommunicationLog {
  id        String               @id @default(uuid())
  jobId     String? // Link back to the job if applicable
  channel   CommunicationChannel
  recipient String // e.g., "j***@example.com" (Masked)
  template  String? // e.g., "auth.login_otp"
  provider  String // e.g., "smtp-primary", "pandora"
  status    String // "SENT", "FAILED", "DELIVERED"

  providerMessageId String? // ID returned by the provider
  errorReason       String? @db.Text
  correlationId     String? // To track related system events

  createdAt DateTime @default(now())

  @@index([channel, status])
  @@index([createdAt])
}

model ProviderHealth {
  id                     String    @id @default(uuid())
  providerName           String    @unique
  status                 String    @default("CLOSED") // CLOSED, OPEN, HALF_OPEN
  consecutiveFailures    Int       @default(0)
  lastSuccessfulDelivery DateTime?
  cooldownUntil          DateTime?

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// OTP & TELEGRAM LINKING
// -----------------------------------------------------------------------------

model OtpRecord {
  id          String               @id @default(uuid())
  userId      String?
  identifier  String // email or phone
  codeHash    String
  channel     CommunicationChannel
  purpose     String // e.g., 'LOGIN', 'PASSWORD_RESET'
  attempts    Int                  @default(0)
  maxAttempts Int                  @default(5)
  expiresAt   DateTime
  invalidated Boolean              @default(false)

  createdAt DateTime @default(now())

  @@index([identifier, purpose, invalidated])
}

model TelegramLinkingToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// -----------------------------------------------------------------------------
// ENTERPRISE NOTIFICATION & CRON SYSTEM
// -----------------------------------------------------------------------------

model NotificationPreference {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category String // e.g., "SECURITY", "MARKETING", "PAYMENTS", "SYSTEM"
  channels String[] // Array of channels: ["EMAIL", "SMS", "IN_APP", "TELEGRAM", "WHATSAPP"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model NotificationTemplate {
  id      String               @id @default(uuid())
  name    String               @unique // e.g., "auth.welcome"
  channel CommunicationChannel // "EMAIL", "SMS", "TELEGRAM", etc.
  subject String? // Applicable for email
  body    String               @db.Text // Supports mustache/handlebars {{var}}
  active  Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  // In-App Notification Center
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  body       String
  category   String // "SECURITY", "SYSTEM", "ALERT"
  actionUrl  String?
  readAt     DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ScheduledJob {
  id             String    @id @default(uuid())
  name           String    @unique
  cronExpression String? // e.g., "*/5 * * * *" for cron
  runAt          DateTime? // Exact time for reminders

  type    String // e.g., "sync-systems", "send-reminder"
  payload Json?

  active    Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions CronExecution[]

  @@index([nextRunAt, active])
}

model CronExecution {
  id             String       @id @default(uuid())
  scheduledJobId String
  scheduledJob   ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  status     String // "SUCCESS", "FAILED"
  durationMs Int?
  errorMsg   String? @db.Text

  executedAt DateTime @default(now())

  @@index([scheduledJobId, executedAt])
}

// -----------------------------------------------------------------------------
// NEW BULK SMS SCHEMA
// -----------------------------------------------------------------------------

enum OrganizationType {
  BUSINESS
  SCHOOL
  HOSPITAL
  NGO
  GOVERNMENT
  FINANCIAL
  RETAIL
  AGENCY
  INDIVIDUAL
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SenderIdStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum CampaignType {
  BROADCAST
  RECURRING
  DRIP
}

enum CampaignStatus {
  DRAFT
  VALIDATING
  READY
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PREPARING
  RUNNING
  PROCESSING
  PAUSING
  PAUSED
  RESUMING
  COMPLETING
  SENT
  PARTIALLY_SENT
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLING
  CANCELLED
}

enum MessageStatus {
  PENDING
  QUEUED
  SUBMITTED
  SENT
  DELIVERED
  FAILED
  EXPIRED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  DEDUCTION
  REFUND
  ADJUSTMENT
  COMMISSION_PAYOUT
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum CommissionType {
  PERCENTAGE
  FIXED
  TIERED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WebhookEvent {
  SMS_SENT
  SMS_DELIVERED
  SMS_FAILED
  CAMPAIGN_COMPLETED
  CAMPAIGN_FAILED
  BALANCE_CHANGED
  API_EVENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ── ORGANIZATION ──────────────────────────────────────────
model Organization {
  id           String           @id @default(uuid())
  name         String
  type         OrganizationType @default(BUSINESS)
  email        String?          @unique
  phone        String?
  address      String?
  city         String?
  country      String           @default("UG")
  logo         String?
  primaryColor String?          @db.VarChar(7)
  brandName    String?
  metadata     Json?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  clients   Client[]
  wallets   Wallet[]
  apiKeys   ApiKey[]
  senderIds SenderId[]
  smsDrafts SmsDraft[]

  gateways Gateway[]

  @@index([name])
}

// ── CLIENT ────────────────────────────────────────────────
model Client {
  id             String       @id @default(uuid())
  userId         String       @unique
  organizationId String?
  agentId        String?
  status         ClientStatus @default(ACTIVE)
  companyName    String?
  industry       String?
  referralSource String?
  notes          String?      @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  wallet       Wallet?
  campaigns    Campaign[]
  senderIds    SenderId[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  commissions  Commission[]

  @@index([userId])
  @@index([agentId])
  @@index([organizationId])
  @@index([status])
}

// ── AGENT / RESELLER ──────────────────────────────────────
model Agent {
  id             String         @id @default(uuid())
  userId         String         @unique
  status         AgentStatus    @default(ACTIVE)
  companyName    String?
  commissionType CommissionType @default(PERCENTAGE)
  commissionRate Decimal        @default(5.0) @db.Decimal(10, 4)
  totalEarnings  Decimal        @default(0) @db.Decimal(15, 4)
  pendingPayout  Decimal        @default(0) @db.Decimal(15, 4)
  bankName       String?
  bankAccount    String?
  mobileMoney    String?
  notes          String?        @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients         Client[]
  commissions     Commission[]
  commissionRules CommissionRule[]
  wallet          Wallet?

  @@index([userId])
  @@index([status])
}

// ── CONTACT ───────────────────────────────────────────────
model Contact {
  id              String    @id @default(uuid())
  userId          String
  firstName       String?
  lastName        String?
  phone           String
  email           String?
  countryCode     String    @default("+256")
  normalizedPhone String
  customFields    Json?
  optedOut        Boolean   @default(false)
  blacklisted     Boolean   @default(false)
  consentGiven    Boolean   @default(false)
  consentDate     DateTime?
  source          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups            ContactGroupMember[]
  tags              ContactTagAssignment[]
  messageRecipients MessageRecipient[]
  consentLogs       ConsentLog[]

  @@unique([userId, normalizedPhone])
  @@index([userId])
  @@index([normalizedPhone])
  @@index([phone])
  @@index([deletedAt])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, optedOut])
}

// ── CONTACT GROUP ─────────────────────────────────────────
model ContactGroup {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?  @db.VarChar(7)
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   ContactGroupMember[]
  campaigns CampaignGroup[]

  @@unique([userId, name])
  @@index([userId])
}

model ContactGroupMember {
  contactId      String
  contactGroupId String
  addedAt        DateTime @default(now())

  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactGroup ContactGroup @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)

  @@id([contactId, contactGroupId])
  @@index([contactGroupId])
}

// ── CONTACT TAG ───────────────────────────────────────────
model ContactTag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now())

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments ContactTagAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model ContactTagAssignment {
  contactId    String
  contactTagId String
  assignedAt   DateTime @default(now())

  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactTag ContactTag @relation(fields: [contactTagId], references: [id], onDelete: Cascade)

  @@id([contactId, contactTagId])
  @@index([contactTagId])
}

// ==========================================
// DYNAMIC SEGMENT
// ==========================================
model ContactSegment {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  rules       Json // Stores the DSL logic
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 📱 CONTACT IMPORT 📱
model ContactImport {
  id               String    @id @default(uuid())
  userId           String
  fileName         String
  fileSize         Int
  totalRecords     Int       @default(0)
  validRecords     Int       @default(0)
  invalidRecords   Int       @default(0)
  duplicateRecords Int       @default(0)
  importedRecords  Int       @default(0)
  skippedRecords   Int       @default(0)
  columnMapping    Json?
  errors           Json?
  status           String    @default("PENDING")
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ── SENDER ID ─────────────────────────────────────────────
model SenderId {
  id              String         @id @default(uuid())
  userId          String
  clientId        String?
  organizationId  String?
  senderId        String
  purpose         String?
  status          SenderIdStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaigns         Campaign[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]

  @@unique([senderId, userId])
  @@index([userId])
  @@index([status])
  @@index([senderId])
}

// ── SMS TEMPLATE ──────────────────────────────────────────
model SmsTemplate {
  id         String   @id @default(uuid())
  userId     String
  name       String
  category   String?
  message    String   @db.Text
  variables  String[] @default([])
  isFavorite Boolean  @default(false)
  isShared   Boolean  @default(false)
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([category])
}

// ── CAMPAIGN ──────────────────────────────────────────────
model Campaign {
  id                String         @id @default(uuid())
  userId            String
  clientId          String?
  senderIdId        String?
  name              String
  message           String         @db.Text
  variables         String[]       @default([])
  status            CampaignStatus @default(DRAFT)
  type              CampaignType   @default(BROADCAST)
  cronExpression    String?
  maxOccurrences    Int?
  currentOccurrence Int            @default(0)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  totalRecipients   Int            @default(0)
  totalSmsUnits     Int            @default(0)
  totalCost         Decimal        @default(0) @db.Decimal(15, 4)
  sentCount         Int            @default(0)
  deliveredCount    Int            @default(0)
  failedCount       Int            @default(0)
  pendingCount      Int            @default(0)
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  senderId SenderId?       @relation(fields: [senderIdId], references: [id], onDelete: SetNull)
  messages Message[]
  groups   CampaignGroup[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId, deletedAt, createdAt])
  @@index([status, scheduledAt])
  @@index([clientId, status])
}

model CampaignGroup {
  campaignId     String
  contactGroupId String

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactGroup ContactGroup @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)

  @@id([campaignId, contactGroupId])
}

// ── MESSAGE ───────────────────────────────────────────────
model Message {
  id                String        @id @default(uuid())
  campaignId        String?
  userId            String
  senderIdId        String?
  smsProviderId     String?
  message           String        @db.Text
  encoding          String        @default("GSM-7")
  segmentCount      Int           @default(1)
  recipientCount    Int           @default(1)
  totalUnits        Int           @default(1)
  costPerUnit       Decimal       @default(0) @db.Decimal(10, 4)
  totalCost         Decimal       @default(0) @db.Decimal(15, 4)
  status            MessageStatus @default(PENDING)
  providerMessageId String?
  idempotencyKey    String?       @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  retryCount        Int           @default(0)
  maxRetries        Int           @default(3)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  campaign    Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId    SenderId?          @relation(fields: [senderIdId], references: [id], onDelete: SetNull)
  smsProvider SmsProvider?       @relation(fields: [smsProviderId], references: [id], onDelete: SetNull)
  recipients  MessageRecipient[]

  gatewayId String?
  gateway   Gateway?         @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  attempts  MessageAttempt[]

  @@index([gatewayId])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([providerMessageId])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([campaignId, status])
}

// ── MESSAGE RECIPIENT ─────────────────────────────────────
model MessageRecipient {
  id            String        @id @default(uuid())
  messageId     String
  contactId     String?
  phone         String
  status        MessageStatus @default(PENDING)
  providerMsgId String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  retryCount    Int           @default(0)
  cost          Decimal       @default(0) @db.Decimal(10, 4)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([contactId])
  @@index([status])
  @@index([phone])
  @@index([providerMsgId])
  @@index([messageId, status])
  @@index([phone, createdAt])
  @@index([status, createdAt])
}

// ── SMS PROVIDER ──────────────────────────────────────────
model SmsProvider {
  id             String   @id @default(uuid())
  name           String   @unique
  displayName    String
  type           String   @default("HTTP")
  baseUrl        String?
  apiKey         String?
  apiSecret      String?
  username       String?
  password       String?
  senderId       String?
  costPerSms     Decimal  @default(0) @db.Decimal(10, 4)
  priority       Int      @default(0)
  isActive       Boolean  @default(true)
  isFallback     Boolean  @default(false)
  maxThroughput  Int?
  supportsDlr    Boolean  @default(false)
  dlrCallbackUrl String?
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]
  routes   ProviderRoute[]

  gateways Gateway[]

  @@index([isActive, priority])
}

// ── PROVIDER ROUTE ────────────────────────────────────────
model ProviderRoute {
  id            String   @id @default(uuid())
  smsProviderId String
  countryCode   String
  networkCode   String?
  costPerSms    Decimal  @default(0) @db.Decimal(10, 4)
  isActive      Boolean  @default(true)
  priority      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  smsProvider SmsProvider @relation(fields: [smsProviderId], references: [id], onDelete: Cascade)

  @@unique([smsProviderId, countryCode, networkCode])
  @@index([countryCode])
}

// ── WALLET ────────────────────────────────────────────────
model Wallet {
  id             String    @id @default(uuid())
  userId         String?   @unique
  clientId       String?   @unique
  agentId        String?   @unique
  organizationId String?
  balance        Decimal   @default(0) @db.Decimal(15, 4)
  currency       String    @default("UGX")
  smsCredits     Int       @default(0)
  isActive       Boolean   @default(true)
  lastTopUpAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([clientId])
  @@index([organizationId])
}

// ── TRANSACTION (IMMUTABLE) ───────────────────────────────
model Transaction {
  id             String          @id @default(uuid())
  walletId       String
  userId         String?
  type           TransactionType
  amount         Decimal         @db.Decimal(15, 4)
  balanceBefore  Decimal         @db.Decimal(15, 4)
  balanceAfter   Decimal         @db.Decimal(15, 4)
  currency       String          @default("UGX")
  reference      String          @unique
  description    String?
  campaignId     String?
  messageId      String?
  paymentMethod  String?
  paymentRef     String?
  idempotencyKey String?         @unique
  metadata       Json?
  createdAt      DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([reference])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([userId, createdAt])
}

// ── SMS PRICING ───────────────────────────────────────────
model SmsPricing {
  id            String    @id @default(uuid())
  countryCode   String
  countryName   String
  networkCode   String?
  networkName   String?
  costPerSms    Decimal   @db.Decimal(10, 4)
  sellingPrice  Decimal   @db.Decimal(10, 4)
  currency      String    @default("UGX")
  clientId      String?
  agentId       String?
  isDefault     Boolean   @default(true)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([countryCode, networkCode, clientId, agentId, isDefault])
  @@index([countryCode])
  @@index([clientId])
  @@index([isActive])
}

// ── COMMISSION ────────────────────────────────────────────
model Commission {
  id             String           @id @default(uuid())
  agentId        String
  clientId       String
  transactionRef String?
  campaignId     String?
  messageCount   Int              @default(0)
  totalSmsValue  Decimal          @default(0) @db.Decimal(15, 4)
  commissionRate Decimal          @db.Decimal(10, 4)
  commissionType CommissionType   @default(PERCENTAGE)
  amount         Decimal          @db.Decimal(15, 4)
  status         CommissionStatus @default(PENDING)
  approvedAt     DateTime?
  approvedBy     String?
  paidAt         DateTime?
  reversedAt     DateTime?
  reversalReason String?
  idempotencyKey String?          @unique
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

// ── COMMISSION RULE ───────────────────────────────────────
model CommissionRule {
  id        String         @id @default(uuid())
  agentId   String?
  name      String
  type      CommissionType @default(PERCENTAGE)
  rate      Decimal        @db.Decimal(10, 4)
  minVolume Int?
  maxVolume Int?
  isDefault Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isActive])
}

// ── API KEY ───────────────────────────────────────────────
model ApiKey {
  id              String       @id @default(uuid())
  userId          String
  clientId        String?
  organizationId  String?
  name            String
  appName         String       @default("Default App")
  environment     String       @default("production")
  keyPrefix       String       @db.VarChar(12)
  keyHash         String       @unique
  status          ApiKeyStatus @default(ACTIVE)
  scopes          String[]     @default(["sms.send", "sms.status", "balance.read"])
  ipWhitelist     String[]     @default([])
  rateLimit       Int          @default(100)
  rateLimitWindow Int          @default(60)
  quotaLimit      Int?
  quotaPeriod     String?      @default("MONTHLY")
  quotaUsed       Int          @default(0)
  quotaResetAt    DateTime?
  alertThreshold  Int?         @default(80)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  apiRequests  ApiRequest[]

  @@index([userId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@index([status])
  @@index([appName])
  @@index([environment])
}

// ── API REQUEST LOG ───────────────────────────────────────
model ApiRequest {
  id           String   @id @default(uuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  requestBody  Json?
  responseBody Json?
  ipAddress    String?
  userAgent    String?  @db.Text
  durationMs   Int?
  errorCode    String?
  createdAt    DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([apiKeyId, createdAt])
  @@index([endpoint])
  @@index([createdAt])
  @@index([statusCode])
}

// ── WEBHOOK ───────────────────────────────────────────────
model Webhook {
  id          String         @id @default(uuid())
  userId      String
  clientId    String?
  url         String
  secret      String
  events      WebhookEvent[]
  isActive    Boolean        @default(true)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([isActive])
}

// ── WEBHOOK DELIVERY LOG ──────────────────────────────────
model WebhookDelivery {
  id           String       @id @default(uuid())
  webhookId    String
  event        WebhookEvent
  payload      Json
  statusCode   Int?
  response     String?      @db.Text
  attempts     Int          @default(1)
  maxAttempts  Int          @default(3)
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime     @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
  @@index([nextRetryAt, attempts])
  @@index([event])
  @@index([createdAt])
}

// ── SUPPORT TICKET ────────────────────────────────────────
model SupportTicket {
  id         String         @id @default(uuid())
  userId     String
  subject    String
  category   String
  priority   TicketPriority @default(MEDIUM)
  status     TicketStatus   @default(OPEN)
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ── TICKET MESSAGE ────────────────────────────────────────
model TicketMessage {
  id              String   @id @default(uuid())
  ticketId        String
  userId          String?
  message         String   @db.Text
  isAdminResponse Boolean  @default(false)
  attachments     String[] @default([])
  createdAt       DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

// ── SCHEDULED MESSAGE ─────────────────────────────────────
model ScheduledMessage {
  id              String    @id @default(uuid())
  userId          String
  senderIdId      String?
  message         String    @db.Text
  recipients      String[]
  recipientCount  Int       @default(0)
  encoding        String    @default("GSM-7")
  segmentCount    Int       @default(1)
  totalUnits      Int       @default(0)
  estimatedCost   Decimal   @default(0) @db.Decimal(15, 4)
  scheduledAt     DateTime
  timezone        String    @default("Africa/Kampala")
  isRecurring     Boolean   @default(false)
  cronExpression  String?
  status          String    @default("SCHEDULED")
  executedAt      DateTime?
  cancelledAt     DateTime?
  resultMessageId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId SenderId? @relation(fields: [senderIdId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

// -----------------------------------------------------------------------------
// MULTI-GATEWAY SMS SYSTEM (ANDROID & ESP32)
// -----------------------------------------------------------------------------

enum GatewayType {
  CLOUD
  ANDROID
  ESP32_GSM
  SMPP
}

enum GatewayStatus {
  ONLINE
  OFFLINE
  DEGRADED
  PENDING_PAIRING
  SUSPENDED
}

enum MessageAttemptStatus {
  PENDING
  ASSIGNED
  SENT_TO_GATEWAY
  SUBMITTED_TO_MODEM
  SENT
  DELIVERED
  FAILED
}

// ── GATEWAY ───────────────────────────────────────────────
model Gateway {
  id             String        @id @default(uuid())
  name           String
  type           GatewayType   @default(ANDROID)
  status         GatewayStatus @default(PENDING_PAIRING)
  userId         String
  organizationId String?
  smsProviderId  String? // If Cloud/SMPP type

  maxThroughput Int? // SMS per minute
  batchSize     Int     @default(10)
  queuePriority Int     @default(0)
  isShared      Boolean @default(false)

  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  smsProvider  SmsProvider?  @relation(fields: [smsProviderId], references: [id], onDelete: SetNull)

  devices  GatewayDevice[]
  tokens   GatewayToken[]
  logs     GatewayLog[]
  attempts MessageAttempt[]
  messages Message[]

  @@index([userId])
  @@index([status])
  @@index([type])
}

// ── GATEWAY DEVICE ────────────────────────────────────────
model GatewayDevice {
  id        String @id @default(uuid())
  gatewayId String

  batteryLevel    Int? // 0 - 100
  isCharging      Boolean @default(false)
  signalStrength  Int? // -113 dBm to -51 dBm
  networkOperator String? // MTN, Airtel, etc.
  simSlotCount    Int     @default(1)

  appVersion    String?
  osVersion     String?
  hardwareModel String?

  lastHeartbeatAt DateTime?
  ipAddress       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId])
  @@index([lastHeartbeatAt])
}

// ── GATEWAY TOKEN ─────────────────────────────────────────
model GatewayToken {
  id         String    @id @default(uuid())
  gatewayId  String
  tokenHash  String    @unique
  name       String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId])
  @@index([tokenHash])
}

// ── GATEWAY LOG ───────────────────────────────────────────
model GatewayLog {
  id        String @id @default(uuid())
  gatewayId String
  level     String @default("INFO")
  event     String
  message   String @db.Text
  metadata  Json?

  createdAt DateTime @default(now())

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([gatewayId])
  @@index([level])
  @@index([createdAt])
}

// ── MESSAGE ATTEMPT (ROUTING / FAILOVER) ──────────────────
model MessageAttempt {
  id        String               @id @default(uuid())
  messageId String
  gatewayId String
  status    MessageAttemptStatus @default(PENDING)

  providerMsgId String?
  errorCode     String?
  errorMessage  String?

  assignedAt      DateTime?
  sentToGatewayAt DateTime?
  submittedAt     DateTime?
  finalizedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([gatewayId])
  @@index([gatewayId, status, createdAt])
  @@index([status])
}

// -----------------------------------------------------------------------------
// CONSENT MANAGEMENT SYSTEM (PART 7)
// -----------------------------------------------------------------------------

enum ConsentAction {
  OPT_IN
  OPT_OUT
  RENEWAL
  EXPIRED
  REVOKED
  COMPLAINT
}

enum ConsentPurpose {
  MARKETING
  TRANSACTIONAL
  SYSTEM
}

model ConsentLog {
  id                String               @id @default(uuid())
  contactId         String
  tenantId          String? // Organization or Client ID
  channel           CommunicationChannel
  purpose           ConsentPurpose
  action            ConsentAction
  source            String? // e.g., 'WEB_FORM', 'SMS_KEYWORD', 'API', 'MANUAL_IMPORT'
  evidence          String?              @db.Text // IP address, URL, screenshot link, raw SMS
  disclosureVersion String? // Version of terms accepted
  legalBasis        String? // e.g., 'LEGITIMATE_INTEREST', 'EXPLICIT_CONSENT'
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([tenantId])
  @@index([channel, purpose, action])
  @@index([createdAt])
}

// ── SMS DRAFT ──────────────────────────────────────────────
model SmsDraft {
  id               String    @id @default(uuid())
  userId           String
  organizationId   String?
  title            String?
  senderId         String?
  deliveryMode     String    @default("manual") // "manual" | "groups" | "import"
  message          String    @default("") @db.Text
  manualRecipients String    @default("") @db.Text
  recipientCount   Int       @default(0)
  selectedGroupId  String?
  importFilename   String?
  importRowCount   Int?
  templateId       String?
  metadata         Json?
  version          Int       @default(1)
  isShared         Boolean   @default(false)
  lastEditedById   String?
  lastAutosavedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([id, organizationId])
  @@index([id, userId])
}

// ── GLOBAL TELEPHONE NUMBERING & PROVIDER ALLOCATION ──────────

model Region {
  id                       String   @id @default(uuid())
  regionId                 String   @unique // e.g., "UG", "US", "XK", "AC"
  name                     String
  alpha2                   String
  alpha3                   String?
  isCldr                   Boolean  @default(false)
  isUnMember               Boolean  @default(false)
  isTerritory              Boolean  @default(false)
  callingCodes             String[] // Array of dial codes, e.g. ["+256"] or ["+1"]
  libphonenumberSupported  Boolean  @default(true)
  independentPlanAvailable Boolean  @default(true)
  exceptionalSharedCode    Boolean  @default(false)
  sampleE164               String?
  sampleNsnDigits          Int?
  validationRule           String?
  notes                    String?  @db.Text
  displayNameProvenance    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  callingCodeAssignments CallingCodeAssignment[]
  operators              Operator[]
  allocations            Allocation[]
  coverageAudits         CoverageAudit[]

  @@index([alpha2])
  @@index([isUnMember])
  @@index([isTerritory])
}

model CallingCodeAssignment {
  id              String    @id @default(uuid())
  callingCode     String // e.g. "+1", "+256", "+7"
  regionId        String
  leadingDigits   String? // Leading digits / area code distinctions
  isNonGeographic Boolean   @default(false)
  source          String?
  asOf            DateTime?
  ambiguityPolicy String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  region Region @relation(fields: [regionId], references: [regionId], onDelete: Cascade)

  @@index([callingCode])
  @@index([regionId])
}

model NumberingMetadataVersion {
  id           String    @id @default(uuid())
  libraryName  String // e.g. "libphonenumber"
  exactVersion String // e.g. "v9.0.39"
  cldrVersion  String? // e.g. "v45"
  checksum     String?
  builtAt      DateTime?
  reviewedAt   DateTime?
  referenceUrl String?
  license      String    @default("Apache-2.0")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([libraryName, exactVersion])
  @@index([isActive])
}

model Operator {
  id                String    @id @default(uuid())
  operatorId        String    @unique // e.g. "UG_AIRTEL", "UG_MTN", "NG_MTN"
  regionId          String
  legalName         String
  retailBrand       String
  historicalAliases String[]
  classification    String    @default("MNO") // MNO, MVNO, RESELLER
  lifecycleState    String    @default("OPERATIONAL") // OPERATIONAL, ALLOCATED, NOT_YET_OPERATIONAL
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  evidence          String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  region      Region       @relation(fields: [regionId], references: [regionId], onDelete: Cascade)
  allocations Allocation[]

  @@index([regionId])
  @@index([retailBrand])
  @@index([lifecycleState])
}

model Allocation {
  id               String    @id @default(uuid())
  regionId         String
  callingCode      String
  nsnLength        Int
  prefix           String? // Exact prefix, e.g. "70", "790"
  nsnStart         String? // Inclusive range boundary
  nsnEnd           String? // Inclusive range boundary
  operatorId       String?
  brand            String?
  serviceType      String    @default("MOBILE") // MOBILE, FIXED_LINE, TOLL_FREE, etc.
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  publishedAt      DateTime?
  verifiedAt       DateTime?
  sourceUrl        String?
  sourceDocument   String?
  extractionMethod String?   @default("regulator_notice")
  snapshotVersion  String?
  status           String    @default("VERIFIED") // VERIFIED, PROVISIONAL, DISPUTED, HISTORICAL
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  region   Region    @relation(fields: [regionId], references: [regionId], onDelete: Cascade)
  operator Operator? @relation(fields: [operatorId], references: [operatorId], onDelete: SetNull)

  @@index([regionId, callingCode])
  @@index([prefix])
  @@index([operatorId])
  @@index([status])
}

model ProviderObservation {
  id                   String    @id @default(uuid())
  phoneHash            String // Hashed phone number for PII privacy
  e164Redacted         String // Redacted format e.g. "+256770****56"
  providerName         String // Provider name as returned
  packageName          String? // e.g. "line_type_intelligence"
  requestedAt          DateTime  @default(now())
  returnedAt           DateTime  @default(now())
  carrierSemantics     String    @default("provider_defined") // current, original, provider_defined, unknown
  lineType             String?
  mcc                  String?
  mnc                  String?
  portabilitySupported Boolean   @default(false)
  isPorted             Boolean?
  ttlExpiresAt         DateTime?
  costIncurred         Float     @default(0)
  createdAt            DateTime  @default(now())

  @@index([phoneHash])
  @@index([ttlExpiresAt])
}

model CoverageAudit {
  id             String    @id @default(uuid())
  regionId       String
  feature        String // validation, carrier_metadata, official_allocations, ported_current_lookup, fixtures
  coverageStatus String // verified, partial, unknown, unsupported
  recordCount    Int       @default(0)
  source         String
  lastCheckedAt  DateTime  @default(now())
  gaps           String?   @db.Text
  nextReviewDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  region Region @relation(fields: [regionId], references: [regionId], onDelete: Cascade)

  @@index([regionId, feature])
  @@index([coverageStatus])
}

model CustomVariable {
  id            String   @id @default(uuid())
  userId        String
  key           String
  label         String
  description   String?
  fallbackValue String?
  sampleValue   String?
  dataType      String   @default("text")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}
