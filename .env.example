# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Range Bulk SMS"
NEXT_PUBLIC_APP_SHORT_NAME="Range Bulk SMS"
NEXT_PUBLIC_APP_DESCRIPTION="Access to the most powerful tracking platform in the entire telematics industry."

# Database (PostgreSQL via Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/master_template?schema=public"

# Database Configuration (Used by Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="master_template"
POSTGRES_PORT="5432"

# Authentication (Used for signing cookies/tokens)
# Generate a secure secret using: openssl rand -base64 32
AUTH_SECRET="development-secret-do-not-use-in-production-12345"

# Development Seed
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Password123!"

# Legacy email service configuration (active queued delivery requires SMTP below)
EMAIL_PROVIDER="console" # Options: console, smtp, resend
EMAIL_FROM="noreply@example.com"

# Communications Platform Config
CRON_SECRET=test-cron-secret-123
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Master Template"

# Pandora SMS
PANDORA_SMS_USERNAME=
PANDORA_SMS_PASSWORD=
PANDORA_SMS_SENDER_ID=

# TELEGRAM
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_WEBHOOK_SECRET="random_secret_string"

# WHATSAPP (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN="your_meta_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# OTP CONFIG
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Cloudflare Turnstile (Bot Protection on all auth forms)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# TESTING KEYS (always pass, always fail) â€” do NOT use in production:
#   Always Pass site key:   1x00000000000000000000AA
#   Always Pass secret key: 1x0000000000000000000000000000000AA
#   Always Fail site key:   2x00000000000000000000AB
#   Always Fail secret key: 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Distributed rate limiting, cache-aside query caching, and distributed mutex locking (Upstash Serverless Redis)
# Get your free database at: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram account-linking bot username (without @)
TELEGRAM_BOT_USERNAME=

